{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "reviewers": [
    "duplabe"
  ],
  "assignees": [
    "duplabe"
  ],
  "assignAutomerge": true,
  "addLabels": [
    "renovate"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "matchDepTypes": [
        "devDependencies"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy",
        "gomodUpdateImportPaths"
      ]
    },
    {
      "matchUpdateTypes": [
        "digest",
        "pin"
      ],
      "minimumReleaseAge": null
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "platformAutomerge": true,
  "minimumReleaseAge": "14 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional"
}
